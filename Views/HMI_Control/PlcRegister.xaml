<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="PCControl.Views.PlcRegister">
    <Border x:Name="Root"
           Padding="4"
           Background="LightGray"
           CornerRadius="4"
           Focusable="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Tb"
                    Grid.Column="0"
                    Background="{Binding TextBoxBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Foreground="{Binding TextBoxForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalContentAlignment="Center"
                    FontFamily="Segoe UI"
                    FontWeight="SemiBold"
                    PreviewMouseDown="Tb_OpenKeyboard"
                    TouchDown="Tb_OpenKeyboard"
                    PreviewTextInput="Tb_PreviewTextInput"
                    DataObject.Pasting="Tb_Pasting"
                    TextChanged="Tb_TextChanged"
                    KeyDown="Tb_KeyDown"
                    LostFocus="Tb_LostFocus"
                    SizeChanged="Tb_SizeChanged" />
            <TextBlock x:Name="TxtUnit"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Opacity="0.6"
                      FontWeight="Light" />
        </Grid>
    </Border>
</UserControl>
