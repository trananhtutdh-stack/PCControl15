<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       x:Class="PCControl.Views.NumberPadWindow"
       WindowStyle="None"
       ResizeMode="NoResize"
       AllowsTransparency="True"
       Background="#333333"
       MouseLeftButtonDown="Window_MouseLeftButtonDown"
       Width="450"
       Height="600"
       Topmost="True">
    <Window.Resources>
        <Style x:Key="KeyStyle"
              TargetType="Button">
            <Setter Property="FontSize"
                   Value="20" />
            <Setter Property="Margin"
                   Value="4" />
            <Setter Property="Background"
                   Value="#DDDDDD" />
            <Setter Property="Foreground"
                   Value="Black" />
            <Setter Property="BorderBrush"
                   Value="#999" />
            <Setter Property="BorderThickness"
                   Value="1" />
            <Setter Property="Height"
                   Value="90" />
            <Setter Property="Width"
                   Value="120" />
        </Style>
    </Window.Resources>
    <Border CornerRadius="10"
           Background="#222"
           Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="TxtDisplay"
                    Grid.Row="0"
                    FontSize="28"
                    Height="64"
                    Background="White"
                    Foreground="Black"
                    BorderBrush="#444"
                    BorderThickness="2"
                    VerticalContentAlignment="Center"
                    Padding="8"
                    Margin="0,0,0,12" />
            <UniformGrid Grid.Row="1"
                        Columns="3"
                        Rows="4"
                        Margin="0,0,0,12">
                <Button Content="1"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="2"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="3"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="4"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="5"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="6"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="7"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="8"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="9"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="-"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="0"
                       Style="{StaticResource KeyStyle}"
                       Click="Key_Click" />
                <Button Content="⌫"
                       Style="{StaticResource KeyStyle}"
                       Click="Backspace_Click" />
            </UniformGrid>
            <StackPanel Grid.Row="2"
                       Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0">
                <Button Content="Cancel"
                       Width="140"
                       Height="56"
                       Margin="8"
                       Click="Cancel_Click" />
                <Button Content="OK"
                       Width="140"
                       Height="56"
                       Margin="8"
                       Background="#77FF77"
                       Click="OK_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
