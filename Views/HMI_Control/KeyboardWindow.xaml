<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       x:Class="PCControl.Views.KeyboardWindow"
       WindowStyle="None"
       ResizeMode="NoResize"
       AllowsTransparency="True"
       Background="#333333"
       Width="900"
       Height="500">
    <Border CornerRadius="10"
           Background="#222"
           Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="TxtDisplay"
                    Grid.Row="0"
                    FontSize="32"
                    Height="60"
                    Background="#111"
                    Foreground="White"
                    BorderBrush="#555"
                    VerticalContentAlignment="Center"
                    Margin="0,0,0,20" />
            <UniformGrid Grid.Row="1"
                        Columns="10"
                        Rows="4"
                        Margin="0,10">
                <Button Content="1"
                       Click="Key_Click" />
                <Button Content="2"
                       Click="Key_Click" />
                <Button Content="3"
                       Click="Key_Click" />
                <Button Content="4"
                       Click="Key_Click" />
                <Button Content="5"
                       Click="Key_Click" />
                <Button Content="6"
                       Click="Key_Click" />
                <Button Content="7"
                       Click="Key_Click" />
                <Button Content="8"
                       Click="Key_Click" />
                <Button Content="9"
                       Click="Key_Click" />
                <Button Content="0"
                       Click="Key_Click" />
                <Button Content="q"
                       Click="Key_Click" />
                <Button Content="w"
                       Click="Key_Click" />
                <Button Content="e"
                       Click="Key_Click" />
                <Button Content="r"
                       Click="Key_Click" />
                <Button Content="t"
                       Click="Key_Click" />
                <Button Content="y"
                       Click="Key_Click" />
                <Button Content="u"
                       Click="Key_Click" />
                <Button Content="i"
                       Click="Key_Click" />
                <Button Content="o"
                       Click="Key_Click" />
                <Button Content="p"
                       Click="Key_Click" />
                <Button Content="a"
                       Click="Key_Click" />
                <Button Content="s"
                       Click="Key_Click" />
                <Button Content="d"
                       Click="Key_Click" />
                <Button Content="f"
                       Click="Key_Click" />
                <Button Content="g"
                       Click="Key_Click" />
                <Button Content="h"
                       Click="Key_Click" />
                <Button Content="j"
                       Click="Key_Click" />
                <Button Content="k"
                       Click="Key_Click" />
                <Button Content="l"
                       Click="Key_Click" />
                <Button Content="."
                       Click="Key_Click" />
                <Button Content="Shift"
                       Click="Shift_Click" />
                <Button Content="z"
                       Click="Key_Click" />
                <Button Content="x"
                       Click="Key_Click" />
                <Button Content="c"
                       Click="Key_Click" />
                <Button Content="v"
                       Click="Key_Click" />
                <Button Content="b"
                       Click="Key_Click" />
                <Button Content="n"
                       Click="Key_Click" />
                <Button Content="m"
                       Click="Key_Click" />
                <Button Content="⌫"
                       Click="Backspace_Click" />
                <Button Content=" "
                       Click="Space_Click" />
            </UniformGrid>
            <StackPanel Grid.Row="2"
                       Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                <Button Content="Cancel"
                       Width="140"
                       Height="56"
                       Margin="8"
                       Click="Cancel_Click" />
                <Button Content="OK"
                       Width="140"
                       Height="56"
                       Margin="8"
                       Background="#77FF77"
                       Click="OK_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
