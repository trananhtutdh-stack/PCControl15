<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="PCControl.Views.PlcButton"
            x:Name="RootCtrl">
    <Border x:Name="Bd"
           CornerRadius="6"
           BorderBrush="Gray"
           BorderThickness="1"
           Padding="6"
           Background="{Binding ButtonBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
           MouseDown="Bd_MouseDown"
           MouseUp="Bd_MouseUp"
           MouseMove="Bd_MouseMove"
           TouchDown="Bd_TouchDown"
           TouchUp="Bd_TouchUp"
           TouchMove="Bd_TouchMove">
        <StackPanel x:Name="LayoutPanel"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <Image x:Name="IconImg"
                  Width="15"
                  Height="15"
                  Margin="4"
                  Visibility="Collapsed" />
            <TextBlock x:Name="Txt"
                      Text="{Binding ButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      VerticalAlignment="Center"
                      FontSize="14"
                      Foreground="Black" />
        </StackPanel>
    </Border>
</UserControl>
