<UserControl
    x:Class="PCControl.Views.Motion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:PCControl.Converters"
    xmlns:viewmodel="clr-namespace:PCControl.ViewModel">

    <Border
        Background="{DynamicResource BgBrush}"
        Padding="5">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock
                    Text="{DynamicResource MotionControl}"
                    Foreground="{DynamicResource AccentBrush}"
                    FontSize="14"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Button
                        Content="STOP ALL"
                        Style="{StaticResource MotionStopAllButton}"
                        Command="{Binding StopAllCommand}"/>
                    
                </StackPanel>
            </Grid>
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">

                <ItemsControl
                    ItemsSource="{Binding Axes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="280"
                                Margin="3"
                                Padding="8"
                                Style="{StaticResource MotionAxisCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="40"/>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="125"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            Style="{StaticResource MotionAxisTitle}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button
                                        Grid.Row="1"
                                        Content="{Binding IsServoON,
                                            Converter={StaticResource
                                                BoolToServoTextConverter}}"
                                        Background="{Binding IsServoON,
                                            Converter={StaticResource
                                                AxisServoBrushConverter}}"
                                        Style="{StaticResource MotionServoButton}"
                                        Command="{Binding
                                            DataContext.ServoCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"/>
                                    <Button
                                        Grid.Row="2"
                                        Content="{Binding IsHomeDone,
                                            Converter={StaticResource
                                                BoolToServoHomeTextConverter}}"
                                        Background="{Binding IsHomeDone,
                                            Converter={StaticResource
                                                BoolToHomeBrushConverter}}"
                                        Style="{StaticResource MotionHomeButton}"
                                        Command="{Binding
                                            DataContext.HomeCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"/>
                                    <Grid Grid.Row="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel
                                            Grid.Row="0"
                                            Orientation="Horizontal">
                                            <Ellipse
                                                Tag="Ready"
                                                Style="{StaticResource MotionStatusDot}"/>
                                            <TextBlock
                                                Text="READY"
                                                Style="{StaticResource MotionLabel}"/>
                                            <Ellipse
                                                Tag="Busy"
                                                Style="{StaticResource MotionStatusDot}"/>
                                            <TextBlock
                                                Text="BUSY"
                                                Style="{StaticResource MotionLabel}"/>
                                            <Ellipse
                                                Tag="Error"
                                                Style="{StaticResource MotionStatusDot}"/>
                                            <TextBlock
                                                Text="ERR"
                                                Style="{StaticResource MotionLabel}"/>
                                            <Ellipse
                                                Margin="8,0,0,0"
                                                Style="{StaticResource CanMoveIndicator}"/>
                                            <TextBlock
                                                Style="{StaticResource CanMoveText}"/>
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Row="1"
                                            Orientation="Horizontal">
                                            <Ellipse
                                                Style="{StaticResource MotionStatusDot}"
                                                Fill="{Binding
                                                    ExternalPositiveLS,
                                                    Converter={StaticResource
                                                        BoolToBrushConverter}}"/>
                                            <TextBlock
                                                Text="L+"
                                                Style="{StaticResource MotionLabel}"/>
                                            <Ellipse
                                                Margin="8,0,0,0"
                                                Style="{StaticResource MotionStatusDot}"
                                                Fill="{Binding
                                                    HomeSW,
                                                    Converter={StaticResource
                                                        BoolToBrushConverter}}"/>
                                            <TextBlock
                                                Text="ORG"
                                                Style="{StaticResource MotionLabel}"/>
                                            <Ellipse
                                                Margin="8,0,0,0"
                                                Style="{StaticResource MotionStatusDot}"
                                                Fill="{Binding
                                                    ExternalNegativeLS,
                                                    Converter={StaticResource
                                                        BoolToBrushConverter}}"/>
                                            <TextBlock
                                                Text="L-"
                                                Style="{StaticResource MotionLabel}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Content="JOG -"
                                            Margin="1"
                                            Style="{StaticResource MotionJogButton}"
                                            Command="{Binding
                                                DataContext.JogNegativeCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>
                                        <RadioButton
                                            Grid.Column="1"
                                            Content="H"
                                            Style="{StaticResource MotionLevelButton}"
                                            IsChecked="{Binding JogLevel,
                                            Converter={StaticResource JogLevelToBoolConverter},
                                            ConverterParameter=3}"
                                            Command="{Binding
                                            DataContext.JogHighCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>
                                        <RadioButton
                                            Grid.Column="2"
                                            Content="M"
                                            Style="{StaticResource MotionLevelButton}"
                                            IsChecked="{Binding JogLevel,
                                                Converter={StaticResource JogLevelToBoolConverter},
                                                ConverterParameter=2}"
                                            Command="{Binding
                                                DataContext.JogMediumCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>
                                        <RadioButton
                                            Grid.Column="3"
                                            Content="L"
                                            Style="{StaticResource MotionLevelButton}"
                                            IsChecked="{Binding JogLevel,
                                                Converter={StaticResource JogLevelToBoolConverter},
                                                ConverterParameter=1}"
                                            Command="{Binding
                                                DataContext.JogLowCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>
                                        <Button
                                            Grid.Column="4"
                                            Content="JOG +"
                                            Margin="1"
                                            Style="{StaticResource MotionJogButton}"
                                            Command="{Binding
                                                DataContext.JogPositiveCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>
                                    </Grid>
                                    <Button
                                        Grid.Row="5"
                                        Content="STOP"
                                        Margin="0,2"
                                        Style="{StaticResource MotionStopButton}"
                                        Command="{Binding
                                            DataContext.StopAxisCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"/>
                                    <Border
                                        Grid.Row="6"
                                        Margin="0,4,0,4"
                                        Padding="6"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="20"/>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Text="{DynamicResource MovePosition}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                VerticalAlignment="Center"/>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{DynamicResource Target}"
                                                    Style="{StaticResource MotionLabel}"
                                                    VerticalAlignment="Center"/>
                                                <TextBox
                                                    Grid.Column="1"
                                                    Text="{Binding TargetPos,
                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource MotionValue}"
                                                    HorizontalContentAlignment="Right"
                                                    VerticalContentAlignment="Center"/>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="mm"
                                                    Style="{StaticResource MotionLabel}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{DynamicResource Speed}"
                                                    Style="{StaticResource MotionLabel}"
                                                    VerticalAlignment="Center"/>
                                                <TextBox
                                                    Grid.Column="1"
                                                    Text="{Binding Speed,
                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource MotionValue}"
                                                    HorizontalContentAlignment="Right"
                                                    VerticalContentAlignment="Center"/>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="mm/s"
                                                    Style="{StaticResource MotionLabel}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Grid.Row="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.Column="0"
                                                    Content="{DynamicResource MoveAbsolute}"
                                                    Style="{StaticResource MotionMoveButton}"
                                                    Command="{Binding
                                                        DataContext.MoveAbsoluteCommand,
                                                        RelativeSource={
                                                            RelativeSource
                                                            AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}"/>
                                                <Button
                                                    Grid.Column="1"
                                                    Content="{DynamicResource MoveRelative}"
                                                    Style="{StaticResource MotionMoveButton}"
                                                    Command="{Binding
                                                        DataContext.MoveRelativeCommand,
                                                        RelativeSource={
                                                            RelativeSource
                                                            AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer
                                        Grid.Row="7"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="85"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="27"/>
                                                <RowDefinition Height="27"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Text="Position"
                                                Style="{StaticResource MotionLabel}"/>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Text="{Binding CurrentPos,
                                                    StringFormat={}{0:F3}}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"/>
                                            <TextBlock
                                                Grid.Row="1"
                                                Text="Speed"
                                                Style="{StaticResource MotionLabel}"/>
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="{Binding CurrentSpeed,
                                                    StringFormat={}{0:F2}}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"/>
                                            <TextBlock
                                                Grid.Row="2"
                                                Text="Jog Acc"
                                                Style="{StaticResource MotionLabel}"/>
                                            <TextBox
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Text="{Binding JogAcc,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource MotionValue}"/>
                                            <TextBlock
                                                Grid.Row="3"
                                                Text="Jog Dec"
                                                Style="{StaticResource MotionLabel}"/>
                                            <TextBox
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Text="{Binding JogDec,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource MotionValue}"/>
                                            <TextBlock
                                                Grid.Row="4"
                                                Text="Pos Acc"
                                                Style="{StaticResource MotionLabel}"/>
                                            <TextBox
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                Text="{Binding PosAcc,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource MotionValue}"/>
                                            <TextBlock
                                                Grid.Row="5"
                                                Text="Pos Dec"
                                                Style="{StaticResource MotionLabel}"/>
                                            <TextBox
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                Text="{Binding PosDec,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource MotionValue}"/>
                                            <TextBlock
                                                Grid.Row="6"
                                                Text="Creep"
                                                Style="{StaticResource MotionLabel}"/>
                                            <TextBox
                                                Grid.Row="6"
                                                Grid.Column="1"
                                                Text="{Binding CreepSpeed,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource MotionValue}"/>
                                            <TextBlock
                                                Grid.Row="7"
                                                Text="Jog H"
                                                Style="{StaticResource MotionLabel}"/>
                                            <TextBox
                                                Grid.Row="7"
                                                Grid.Column="1"
                                                Text="{Binding JogHSpeed,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource MotionValue}"/>
                                            <TextBlock
                                                Grid.Row="8"
                                                Text="Jog M"
                                                Style="{StaticResource MotionLabel}"/>
                                            <TextBox
                                                Grid.Row="8"
                                                Grid.Column="1"
                                                Text="{Binding JogMSpeed,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource MotionValue}"/>
                                            <TextBlock
                                                Grid.Row="9"
                                                Text="Jog L"
                                                Style="{StaticResource MotionLabel}"/>
                                            <TextBox
                                                Grid.Row="9"
                                                Grid.Column="1"
                                                Text="{Binding JogLSpeed,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource MotionValue}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>