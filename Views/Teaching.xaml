<UserControl
    x:Class="PCControl.Views.Teaching"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{DynamicResource BgBrush}"
        Padding="1">

        <Grid>

            <!-- ========================================================= -->
            <!-- ROWS                                                        -->
            <!-- ========================================================= -->

            <Grid.RowDefinitions>

                <!-- Header -->
                <RowDefinition Height="32"/>

                <!-- Axis -->
                <RowDefinition Height="270"/>

                <!-- Matrix -->
                <RowDefinition Height="145"/>

                <!-- Tool / Robot -->
                <RowDefinition Height="145"/>

                <!-- Moving / Tool -->
                <RowDefinition Height="145"/>

            </Grid.RowDefinitions>


            <!-- ========================================================= -->
            <!-- HEADER                                                      -->
            <!-- ========================================================= -->

            <Grid Grid.Row="0">

                <TextBlock
                    Text="{Binding SelectedChannelName,
                                   StringFormat={}{0} TEACHING}"
                    Foreground="{DynamicResource AccentBrush}"
                    FontSize="11"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>


                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                    <RadioButton
                        Content="CH1"
                        Width="55"
                        Height="28"
                        Margin="1"
                        IsChecked="{Binding IsCH1Selected}"
                        Command="{Binding SelectCH1Command}"
                        Style="{StaticResource MotionLevelButton}"/>

                    <RadioButton
                        Content="CH2"
                        Width="55"
                        Height="28"
                        Margin="1"
                        IsChecked="{Binding IsCH2Selected}"
                        Command="{Binding SelectCH2Command}"
                        Style="{StaticResource MotionLevelButton}"/>

                </StackPanel>

            </Grid>


            <!-- ========================================================= -->
            <!-- AXIS                                                        -->
            <!-- GIỮ NGUYÊN KIỂU HIỂN THỊ CỦA MOTION                       -->
            <!-- ========================================================= -->

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">

                <ItemsControl
                    ItemsSource="{Binding Axes}">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <StackPanel
                                Orientation="Horizontal"/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Width="280"
                                Margin="1"
                                Padding="1"
                                Style="{StaticResource MotionAxisCard}">

                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="40"/>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="*"/>

                                    </Grid.RowDefinitions>


                                    <!-- AXIS NAME -->

                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{Binding Name}"
                                        Style="{StaticResource MotionAxisTitle}"
                                        VerticalAlignment="Center"/>


                                    <!-- SERVO -->

                                    <Button
                                        Grid.Row="1"
                                        Content="{Binding IsServoON,
                                            Converter={StaticResource
                                                BoolToServoTextConverter}}"
                                        Background="{Binding IsServoON,
                                            Converter={StaticResource
                                                AxisServoBrushConverter}}"
                                        Style="{StaticResource MotionServoButton}"
                                        Command="{Binding
                                            DataContext.ServoCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"/>


                                    <!-- HOME -->

                                    <Button
                                        Grid.Row="2"
                                        Content="{Binding IsHomeDone,
                                            Converter={StaticResource
                                                BoolToServoHomeTextConverter}}"
                                        Background="{Binding IsHomeDone,
                                            Converter={StaticResource
                                                BoolToHomeBrushConverter}}"
                                        Style="{StaticResource MotionHomeButton}"
                                        Command="{Binding
                                            DataContext.HomeCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"/>


                                    <!-- STATUS -->

                                    <Grid Grid.Row="3">

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>

                                        </Grid.RowDefinitions>


                                        <StackPanel
                                            Grid.Row="0"
                                            Orientation="Horizontal">

                                            <Ellipse
                                                Tag="Ready"
                                                Style="{StaticResource MotionStatusDot}"/>
                                            <TextBlock
                                                Text="READY"
                                                Style="{StaticResource MotionLabel}"/>
                                            <Ellipse
                                                Tag="Busy"
                                                Style="{StaticResource MotionStatusDot}"/>
                                            <TextBlock
                                                Text="BUSY"
                                                Style="{StaticResource MotionLabel}"/>
                                            <Ellipse
                                                Tag="Error"
                                                Style="{StaticResource MotionStatusDot}"/>
                                            <TextBlock
                                                Text="ERR"
                                                Style="{StaticResource MotionLabel}"/>
                                            <Ellipse
                                                Margin="8,0,0,0"
                                                Style="{StaticResource CanMoveIndicator}"/>
                                            <TextBlock
                                                Style="{StaticResource CanMoveText}"/>

                                        </StackPanel>


                                        <StackPanel
                                            Grid.Row="1"
                                            Orientation="Horizontal">

                                            <Ellipse
                                                Style="{StaticResource MotionStatusDot}"
                                                Fill="{Binding
                                                    ExternalPositiveLS,
                                                    Converter={StaticResource
                                                        BoolToBrushConverter}}"/>

                                            <TextBlock
                                                Text="L+"
                                                Style="{StaticResource MotionLabel}"/>


                                            <Ellipse
                                                Margin="7,0,0,0"
                                                Style="{StaticResource MotionStatusDot}"
                                                Fill="{Binding
                                                    HomeSW,
                                                    Converter={StaticResource
                                                        BoolToBrushConverter}}"/>

                                            <TextBlock
                                                Text="ORG"
                                                Style="{StaticResource MotionLabel}"/>


                                            <Ellipse
                                                Margin="7,0,0,0"
                                                Style="{StaticResource MotionStatusDot}"
                                                Fill="{Binding
                                                    ExternalNegativeLS,
                                                    Converter={StaticResource
                                                        BoolToBrushConverter}}"/>

                                            <TextBlock
                                                Text="L-"
                                                Style="{StaticResource MotionLabel}"/>

                                        </StackPanel>

                                    </Grid>


                                    <!-- JOG -->

                                    <Grid Grid.Row="4">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>


                                        <Button
                                            Grid.Column="0"
                                            Content="JOG -"
                                            Style="{StaticResource MotionJogButton}"
                                            Command="{Binding
                                                DataContext.JogNegativeCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>


                                        <RadioButton
                                            Grid.Column="1"
                                            Content="H"
                                            Style="{StaticResource MotionLevelButton}"
                                            IsChecked="{Binding
                                                JogLevel,
                                                Converter={StaticResource
                                                    JogLevelToBoolConverter},
                                                ConverterParameter=3}"
                                            Command="{Binding
                                                DataContext.JogHighCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>


                                        <RadioButton
                                            Grid.Column="2"
                                            Content="M"
                                            Style="{StaticResource MotionLevelButton}"
                                            IsChecked="{Binding
                                                JogLevel,
                                                Converter={StaticResource
                                                    JogLevelToBoolConverter},
                                                ConverterParameter=2}"
                                            Command="{Binding
                                                DataContext.JogMediumCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>


                                        <RadioButton
                                            Grid.Column="3"
                                            Content="L"
                                            Style="{StaticResource MotionLevelButton}"
                                            IsChecked="{Binding
                                                JogLevel,
                                                Converter={StaticResource
                                                    JogLevelToBoolConverter},
                                                ConverterParameter=1}"
                                            Command="{Binding
                                                DataContext.JogLowCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>


                                        <Button
                                            Grid.Column="4"
                                            Content="JOG +"
                                            Style="{StaticResource MotionJogButton}"
                                            Command="{Binding
                                                DataContext.JogPositiveCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>

                                    </Grid>


                                    <!-- STOP -->

                                    <Button
                                        Grid.Row="5"
                                        Content="STOP"
                                        Style="{StaticResource MotionStopButton}"
                                        Command="{Binding
                                            DataContext.StopAxisCommand,
                                            RelativeSource={RelativeSource
                                                AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"/>


                                    <!-- POSITION / SPEED -->

                                    <Grid Grid.Row="6">

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>

                                        </Grid.RowDefinitions>


                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>

                                        </Grid.ColumnDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Text="Position"
                                            Style="{StaticResource MotionLabel}"/>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding CurrentPos,
                                                StringFormat={}{0:F3}}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Right"/>


                                        <TextBlock
                                            Grid.Row="1"
                                            Text="Speed"
                                            Style="{StaticResource MotionLabel}"/>

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding CurrentSpeed,
                                                StringFormat={}{0:F2}}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Right"/>

                                    </Grid>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>


            <!-- ========================================================= -->
            <!-- JIG MATRIX / TRAY MATRIX / POSITION DATA                  -->
            <!-- ========================================================= -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.70*"/>

                </Grid.ColumnDefinitions>


                <!-- ===================================================== -->
                <!-- JIG MATRIX                                             -->
                <!-- ===================================================== -->

                <Border
                    Grid.Column="0"
                    Margin="2"
                    Padding="5"
                    Style="{StaticResource TeachingPanel}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="JIG MATRIX"
                            Style="{StaticResource TeachingTitle}"/>


                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{Binding JigData.Positions}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <UniformGrid
                                        Columns="{Binding DataContext.JigData.Columns,
                                            RelativeSource={
                                                RelativeSource
                                                AncestorType={x:Type UserControl}}}"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>


                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button
                                        Content="{Binding Name}"
                                        Margin="2"
                                        Command="{Binding
                                            DataContext.SelectJigPositionCommand,
                                            RelativeSource={
                                                RelativeSource
                                                AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource TeachingManualButton}"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Border>


                <!-- ===================================================== -->
                <!-- TRAY MATRIX                                            -->
                <!-- ===================================================== -->

                <Border
                    Grid.Column="1"
                    Margin="2"
                    Padding="5"
                    Style="{StaticResource TeachingPanel}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="TRAY MATRIX"
                            Style="{StaticResource TeachingTitle}"/>


                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{Binding TrayData.Positions}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <UniformGrid
                                        Columns="{Binding DataContext.TrayData.Columns,
                                            RelativeSource={
                                                RelativeSource
                                                AncestorType={x:Type UserControl}}}"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>


                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button
                                        Content="{Binding Name}"
                                        Margin="2"
                                        Command="{Binding
                                            DataContext.SelectTrayPositionCommand,
                                            RelativeSource={
                                                RelativeSource
                                                AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource TeachingManualButton}"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Border>


                <!-- ===================================================== -->
                <!-- POSITION DATA                                          -->
                <!-- ===================================================== -->

                <Border
                    Grid.Column="2"
                    Margin="2"
                    Padding="5"
                    Style="{StaticResource TeachingPanel}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="28"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="POSITION DATA"
                            Style="{StaticResource TeachingTitle}"/>


                        <Grid Grid.Row="1">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>

                            </Grid.RowDefinitions>


                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                                Text="X"
                                Style="{StaticResource MotionLabel}"/>

                            <TextBox
                                Grid.Column="1"
                                Text="{Binding SelectedPosition.X,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MotionValue}"/>


                            <TextBlock
                                Grid.Row="1"
                                Text="Y"
                                Style="{StaticResource MotionLabel}"/>

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding SelectedPosition.Y,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MotionValue}"/>


                            <TextBlock
                                Grid.Row="2"
                                Text="Z"
                                Style="{StaticResource MotionLabel}"/>

                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding SelectedPosition.Z,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MotionValue}"/>

                        </Grid>


                        <Button
                            Grid.Row="2"
                            Content="TEACH CURRENT"
                            Command="{Binding TeachSelectedPositionCommand}"
                            Style="{StaticResource TeachingManualButton}"/>

                    </Grid>

                </Border>

            </Grid>


            <!-- ========================================================= -->
            <!-- TOOL SELECT / ROBOT TEACHING / ROBOT MOVING               -->
            <!-- ========================================================= -->

            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="1.10*"/>

                </Grid.ColumnDefinitions>


                <!-- ===================================================== -->
                <!-- TOOL SELECT                                             -->
                <!-- ===================================================== -->

                <Border
                    Grid.Column="0"
                    Margin="2"
                    Padding="5"
                    Style="{StaticResource TeachingPanel}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="TOOL SELECT"
                            Style="{StaticResource TeachingTitle}"/>


                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{Binding Tools}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <UniformGrid
                                        Columns="2"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>


                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button
                                        Content="{Binding Name}"
                                        Margin="3"
                                        Command="{Binding
                                            DataContext.SelectToolCommand,
                                            RelativeSource={
                                                RelativeSource
                                                AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource TeachingManualButton}"/>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Border>


                <!-- ===================================================== -->
                <!-- ROBOT TEACHING                                          -->
                <!-- ===================================================== -->

                <Border
                    Grid.Column="1"
                    Margin="2"
                    Padding="5"
                    Style="{StaticResource TeachingPanel}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="28"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="ROBOT TEACHING"
                            Style="{StaticResource TeachingTitle}"/>


                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>

                            </Grid.ColumnDefinitions>


                            <Grid.RowDefinitions>

                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>


                            <TextBlock
                                Text="JIG 1ST"
                                Style="{StaticResource MotionLabel}"/>

                            <TextBox
                                Grid.Column="1"
                                Text="{Binding JigData.FirstPosition.X,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MotionValue}"/>

                            <TextBox
                                Grid.Column="2"
                                Text="{Binding JigData.FirstPosition.Y,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MotionValue}"/>

                            <TextBox
                                Grid.Column="3"
                                Text="{Binding JigData.FirstPosition.Z,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MotionValue}"/>

                            <Button
                                Grid.Column="4"
                                Content="TEACH"
                                Command="{Binding TeachJigCommand}"
                                Style="{StaticResource TeachingManualButton}"/>


                            <TextBlock
                                Grid.Row="1"
                                Text="TRAY 1ST"
                                Style="{StaticResource MotionLabel}"/>

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding TrayData.FirstPosition.X,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MotionValue}"/>

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="2"
                                Text="{Binding TrayData.FirstPosition.Y,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MotionValue}"/>

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="3"
                                Text="{Binding TrayData.FirstPosition.Z,
                                    UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MotionValue}"/>

                            <Button
                                Grid.Row="1"
                                Grid.Column="4"
                                Content="TEACH"
                                Command="{Binding TeachTrayCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                        </Grid>


                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Button
                                Content="TEACH Z JIG"
                                Margin="1"
                                Command="{Binding TeachZJigCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                            <Button
                                Grid.Column="1"
                                Content="TEACH Z TRAY"
                                Margin="1"
                                Command="{Binding TeachZTrayCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ===================================================== -->
                <!-- ROBOT MOVING                                            -->
                <!-- ===================================================== -->

                <Border
                    Grid.Column="2"
                    Margin="2"
                    Padding="5"
                    Style="{StaticResource TeachingPanel}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="ROBOT MOVING"
                            Style="{StaticResource TeachingTitle}"/>


                        <UniformGrid
                            Grid.Row="1"
                            Columns="3"
                            Rows="2">

                            <Button
                                Content="Z WAIT POS"
                                Command="{Binding MoveJigFirstCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                            <Button
                                Content="JIG POS MOV"
                                Command="{Binding MoveJigFirstCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                            <Button
                                Content="TRAY POS MOV"
                                Command="{Binding MoveTrayFirstCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                            <Button
                                Content="Z DOWN JIG"
                                Command="{Binding MoveJigZCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                            <Button
                                Content="Z DOWN TRAY"
                                Command="{Binding MoveTrayZCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                            <Button
                                Content="1 CYCLE"
                                Command="{Binding OneCycleCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                        </UniformGrid>

                    </Grid>

                </Border>

            </Grid>


            <!-- ========================================================= -->
            <!-- JIG/TRAY MOVING + TOOL MANUAL                              -->
            <!-- ========================================================= -->

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="0.70*"/>
                    <ColumnDefinition Width="2.30*"/>

                </Grid.ColumnDefinitions>


                <!-- ===================================================== -->
                <!-- JIG / TRAY MOVING                                      -->
                <!-- ===================================================== -->

                <Border
                    Grid.Column="0"
                    Margin="2"
                    Padding="5"
                    Style="{StaticResource TeachingPanel}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="TRAY / JIG MOVING"
                            Style="{StaticResource TeachingTitle}"/>


                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Button
                                Content="JIG IN"
                                Margin="2"
                                Command="{Binding JigBackwardCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                            <Button
                                Grid.Column="1"
                                Content="JIG OUT"
                                Margin="2"
                                Command="{Binding JigForwardCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                        </Grid>


                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Button
                                Content="TRAY IN"
                                Margin="2"
                                Command="{Binding TrayBackwardCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                            <Button
                                Grid.Column="1"
                                Content="TRAY OUT"
                                Margin="2"
                                Command="{Binding TrayForwardCommand}"
                                Style="{StaticResource TeachingManualButton}"/>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ===================================================== -->
                <!-- TOOL MANUAL                                             -->
                <!-- ===================================================== -->

                <Border
                    Grid.Column="1"
                    Margin="2"
                    Padding="5"
                    Style="{StaticResource TeachingPanel}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="TOOL MANUAL"
                            Style="{StaticResource TeachingTitle}"/>


                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{Binding Tools}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <UniformGrid
                                        Columns="4"/>

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>


                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="2"
                                        Padding="3"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">

                                        <Grid>

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="20"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>

                                            </Grid.RowDefinitions>


                                            <TextBlock
                                                Text="{Binding Name}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                HorizontalAlignment="Center"/>


                                            <Button
                                                Grid.Row="1"
                                                Content="VACUUM"
                                                Margin="1"
                                                Background="{Binding IsVacuum,
                                                    Converter={StaticResource
                                                        BoolToBrushConverter}}"
                                                Command="{Binding
                                                    DataContext.VacuumCommand,
                                                    RelativeSource={
                                                        RelativeSource
                                                        AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TeachingManualButton}"/>


                                            <Button
                                                Grid.Row="2"
                                                Content="BLOW"
                                                Margin="1"
                                                Background="{Binding IsBlow,
                                                    Converter={StaticResource
                                                        BoolToBrushConverter}}"
                                                Command="{Binding
                                                    DataContext.BlowCommand,
                                                    RelativeSource={
                                                        RelativeSource
                                                        AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TeachingManualButton}"/>


                                            <Button
                                                Grid.Row="3"
                                                Content="OFF"
                                                Margin="1"
                                                Command="{Binding
                                                    DataContext.ToolOffCommand,
                                                    RelativeSource={
                                                        RelativeSource
                                                        AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TeachingManualButton}"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Border>

</UserControl>