<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:vm="clr-namespace:PCControl.ViewModel"
       xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
       x:Class="PCControl.Views.Dialog.JigSetting"
       d:DataContext="{d:DesignInstance vm:JigSettingViewModel}"
       mc:Ignorable="d"
       Width="340"
       Height="500"
       WindowStyle="None"
       ResizeMode="NoResize"
       Background="#EEF2F7"
       WindowStartupLocation="CenterScreen">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseLeftButtonDown">
            <i:CallMethodAction MethodName="DragMove"
                               TargetObject="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.Resources>
        <Style x:Key="ModernButton"
              TargetType="Button">
            <Setter Property="Height"
                   Value="42" />
            <Setter Property="FontSize"
                   Value="14" />
            <Setter Property="FontWeight"
                   Value="Bold" />
            <Setter Property="BorderThickness"
                   Value="0" />
            <Setter Property="Cursor"
                   Value="Hand" />
            <Setter Property="RenderTransformOrigin"
                   Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1"
                                   ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                               Background="{TemplateBinding Background}"
                               CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                       Property="Opacity"
                                       Value="0.9" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03"
                                                       ScaleY="1.03" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="Bd"
                                       Property="Opacity"
                                       Value="0.75" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97"
                                                       ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernTextBox"
              TargetType="TextBox">
            <Setter Property="Height"
                   Value="34" />
            <Setter Property="Padding"
                   Value="10,0" />
            <Setter Property="FontSize"
                   Value="14" />
            <Setter Property="Background"
                   Value="#F7FAFC" />
            <Setter Property="BorderBrush"
                   Value="#D8E0EA" />
            <Setter Property="BorderThickness"
                   Value="1" />
            <Setter Property="VerticalContentAlignment"
                   Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                               Background="{TemplateBinding Background}"
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                       Property="BorderBrush"
                                       Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                    Value="True">
                                <Setter TargetName="Bd"
                                       Property="BorderBrush"
                                       Value="#3B82F6" />
                                <Setter TargetName="Bd"
                                       Property="BorderThickness"
                                       Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="1"
           Background="#EEF2F7"
           BorderBrush="#C7D0DB"
           BorderThickness="1"
           CornerRadius="10">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Height="56"
                   Background="#D9E5F2"
                   CornerRadius="10"
                   Padding="18,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12"
                            Height="12"
                            Fill="#45C66A"
                            VerticalAlignment="Center" />
                    <TextBlock Text="JIG SETUP"
                              Margin="10,0,0,0"
                              FontSize="22"
                              FontWeight="Bold"
                              Foreground="#243447"
                              VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1"
                   Margin="0,14,0,14"
                   Background="White"
                   BorderBrush="#D6DEE8"
                   BorderThickness="1"
                   CornerRadius="10">
                <StackPanel Margin="18">
                    <TextBlock Text="Jig Parameter"
                              FontSize="17"
                              FontWeight="SemiBold"
                              Foreground="#243447"
                              Margin="0,0,0,18" />
                    <TextBlock Text="Row"
                              FontWeight="SemiBold"
                              Foreground="#4A5568"
                              Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource ModernTextBox}"
                            Text="{Binding PalletTemp.Row}" />
                    <TextBlock Text="Column"
                              FontWeight="SemiBold"
                              Foreground="#4A5568"
                              Margin="0,14,0,5" />
                    <TextBox Style="{StaticResource ModernTextBox}"
                            Text="{Binding PalletTemp.Col}" />
                    <TextBlock Text="Pitch X"
                              FontWeight="SemiBold"
                              Foreground="#4A5568"
                              Margin="0,14,0,5" />
                    <TextBox Style="{StaticResource ModernTextBox}"
                            Text="{Binding PalletTemp.PitchX}" />
                    <TextBlock Text="Pitch Y"
                              FontWeight="SemiBold"
                              Foreground="#4A5568"
                              Margin="0,14,0,5" />
                    <TextBox Style="{StaticResource ModernTextBox}"
                            Text="{Binding PalletTemp.PitchY}" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                       Style="{StaticResource ModernButton}"
                       Content="SAVE"
                       Foreground="White"
                       Background="#3B82F6"
                       Command="{Binding SaveCommand}"
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Grid.Column="2"
                       Style="{StaticResource ModernButton}"
                       Content="CANCEL"
                       Foreground="#374151"
                       Background="#E5EAF1"
                       Command="{Binding CancelCommand}"
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
