<UserControl
    x:Class="PCControl.Views.Cylinder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCControl.ViewModel"
    xmlns:views="clr-namespace:PCControl.Views">

    <Border
        Background="{DynamicResource BgBrush}"
        Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0">
                        
                        <TextBlock 
                            Text="{DynamicResource Cylinder}"
                            Style="{StaticResource MyTextBlock}"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>

                    </Grid>

                    <Grid
                        Grid.Column="1">
                        <TextBlock Text="{DynamicResource State}"
                            Style="{StaticResource MyTextBlock}"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>

                    </Grid>
                    <Grid 
                        Grid.Column="2">
                        <TextBlock Text="{DynamicResource ForwardSensor}"
                            Style="{StaticResource MyTextBlock}"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>

                    </Grid>

                    <Grid 
                        Grid.Column="3">
                        <TextBlock Text="{DynamicResource BackwardSensor}"
                            Style="{StaticResource MyTextBlock}"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>

                    </Grid>

                    <Grid
                        Grid.Column="4">
                        <TextBlock Text="{DynamicResource Control}"
                            Style="{StaticResource MyTextBlock}"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>

                    </Grid>

                    <Grid
                        Grid.Column="5">
                        <TextBlock Text="{DynamicResource BypassSensor}"
                            Style="{StaticResource MyTextBlock}"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>

                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                Margin="0,6,0,0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <ItemsControl
                    ItemsSource="{Binding Cylinders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,3"
                                Padding="10,7"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Grid.Column="0">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            Style="{StaticResource MyTextBlock}"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Padding="12,4"
                                        Background="{DynamicResource BgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <TextBlock
                                            Text="{Binding Status}"
                                            Style="{StaticResource MyTextBlock}"
                                            FontWeight="SemiBold"/>

                                    </Border>
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">

                                        <Ellipse
                                            Width="14"
                                            Height="14"
                                            Margin="4,0,8,0"
                                            Fill="{Binding ForwardSensor,
                                                Converter={StaticResource BoolToBrushConverter}}"/>

                                        <TextBlock
                                            Text="{DynamicResource Forward}"
                                            Style="{StaticResource MotionLabel}"
                                            VerticalAlignment="Center"/>

                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                                        <Ellipse
                                            Width="14"
                                            Height="14"
                                            Margin="4,0,8,0"
                                            Fill="{Binding BackwardSensor,
                                                Converter={StaticResource BoolToBrushConverter}}"/>
                                        <TextBlock
                                            Text="{DynamicResource Backward}"
                                            Style="{StaticResource MotionLabel}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="4"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                        <Button
                                            Content="{DynamicResource Forward}"
                                            Style="{StaticResource CylinderForwardButton}"
                                            Command="{Binding
                                                DataContext.ForwardCommand,
                                                RelativeSource={
                                                    RelativeSource
                                                    AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                        <Button
                                            Content="{DynamicResource Backward}"
                                            Style="{StaticResource CylinderBackwardButton}"
                                            Command="{Binding
                                                DataContext.BackwardCommand,
                                                RelativeSource={
                                                    RelativeSource
                                                    AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                        <Button
                                            Content="STOP"
                                            Style="{StaticResource MotionStopButton}"
                                            Command="{Binding
                                                DataContext.StopCommand,
                                                RelativeSource={
                                                    RelativeSource
                                                    AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="5"
                                        VerticalAlignment="Center">
                                        <CheckBox
                                            Content="{DynamicResource BypassForward}"
                                            IsChecked="{Binding
                                                BypassForwardSensor}"
                                            Style="{StaticResource CylinderBypassCheckBox}"/>
                                        <CheckBox
                                            Content="{DynamicResource BypassBackward}"
                                            IsChecked="{Binding
                                                BypassBackwardSensor}"
                                            Style="{StaticResource CylinderBypassCheckBox}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>