<Window x:Class="PCControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCControl"
        mc:Ignorable="d"
        Title="AUTO LOADER FPCB"
        Width="1400"
        Height="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Background="{DynamicResource BgBrush}">

    <Grid>

        <Grid.RowDefinitions>

            <!-- HEADER -->
            <RowDefinition Height="50"/>

            <!-- NAVIGATOR -->
            <RowDefinition Height="50"/>

            <!-- CURRENT VIEW -->
            <RowDefinition Height="*"/>

            <!-- ALARM + DEBUG -->
            <RowDefinition Height="120"/>

        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#111827">

            <Grid Margin="15,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="300"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="300"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="300"/>

                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="45"
                            Height="45"
                            Background="#2563EB"
                            CornerRadius="5"
                            VerticalAlignment="Center">

                        <TextBlock Text="M"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MyTextBlock}"/>


                    </Border>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" Width="82">



                        <!-- LANGUAGE -->

                        <Button Style="{StaticResource LanguageButton}"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="en">

                            <Image Source="/Assets/Images/Languages/en_64x40.png"
                                   Width="24"
                                   Height="16"
                                   Stretch="Fill"/> 

                        </Button>

                        <Button Style="{StaticResource LanguageButton}"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="zh">  

                            <Image Source="/Assets/Images/Languages/zh_64x40.png"
                                   Width="24"
                                   Height="16"
                                   Stretch="Fill"/> 

                        </Button>

                    </StackPanel>


                    <StackPanel Margin="15,0">

                        <TextBlock Text="{DynamicResource AppTitle}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Style="{StaticResource MyTextBlock}"/>

                        <TextBlock Text="{DynamicResource Version}"
                                   FontSize="12"
                                   Style="{StaticResource MyTextBlock}"/>

                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="Model : "
                               FontSize="18"
                               Style="{StaticResource MyTextBlock}"/>


                    <TextBlock Text="Recipe : "
                               FontSize="18"
                               Style="{StaticResource MyTextBlock}"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                </StackPanel>

            </Grid>
        </Border>

        <Border Grid.Row="1"
        Background="#374151">

            <StackPanel Orientation="Horizontal">
                <Grid>
                    <RadioButton Content="{DynamicResource Main}"
                                 Style="{StaticResource NavigatorButton}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Home"/>

                    <Image Source="/PCControl;component/Assets/Images/Navigation/main.png"
                           Style="{StaticResource NavIconStyle}"
                           IsHitTestVisible="False"/>

                </Grid>

                <Grid>
                    <RadioButton Content="{DynamicResource Manual}"
                                 Style="{StaticResource NavigatorButton}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Cylinder"/>

                    <Image Source="/PCControl;component/Assets/Images/Navigation/manual.png"
                           Style="{StaticResource NavIconStyle}"
                           IsHitTestVisible="False"/>

                </Grid>

                <Grid>
                    <RadioButton Content="{DynamicResource Motion}"
                                 Style="{StaticResource NavigatorButton}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Motion"/>    

                    <Image Source="/PCControl;component/Assets/Images/Navigation/motion.png"
                           Style="{StaticResource NavIconStyle}"
                           IsHitTestVisible="False"/>

                </Grid>


                <Grid>
                    <RadioButton Content="{DynamicResource Teaching}"
                                 Style="{StaticResource NavigatorButton}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Teaching"/>

                    <Image Source="/PCControl;component/Assets/Images/Navigation/motion.png"
                           Style="{StaticResource NavIconStyle}"
                           IsHitTestVisible="False"/>   

                </Grid>

                <Grid>
                    <RadioButton Content="{DynamicResource IO}"
                                 Style="{StaticResource NavigatorButton}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="IoMonitor"/>

                    <Image Source="/PCControl;component/Assets/Images/Navigation/io.png"
                           Style="{StaticResource NavIconStyle}"
                           IsHitTestVisible="False"/>

                </Grid>

                <Grid>
                    <RadioButton Content="{DynamicResource Alarm}"
                                 Style="{StaticResource NavigatorButton}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Alarm"/>

                    <Image Source="/PCControl;component/Assets/Images/Navigation/alarm.png"
                           Style="{StaticResource NavIconStyle}"
                           IsHitTestVisible="False"/>

                </Grid>

                <Grid>
                    <RadioButton Content="{DynamicResource Recipe}"
                                 Style="{StaticResource NavigatorButton}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Recipe"/>    

                    <Image Source="/PCControl;component/Assets/Images/Navigation/recipe.png"
                           Style="{StaticResource NavIconStyle}"
                           IsHitTestVisible="False"/>

                </Grid>

                <Grid>
                    <RadioButton Content="{DynamicResource Setting}"
                         Style="{StaticResource NavigatorButton}"
                         GroupName="MainNavigation"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Setting"/>

                    <Image Source="/PCControl;component/Assets/Images/Navigation/setting.png"
                           Style="{StaticResource NavIconStyle}"
                           IsHitTestVisible="False"/>

                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="4"
                Background="#273449"
                BorderBrush="#4B5563"
                BorderThickness="1"
                CornerRadius="5">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>

        <Border Grid.Row="3"
                Margin="4"
                Style="{StaticResource LogPanelStyle}">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource LogInnerPanelStyle}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource AlarmTitleStyle}">
                                   <Run Text="⚠  "/>
                                   <Run Text="{DynamicResource Alarm}"/>
                        </TextBlock>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Alarms}"
                                 Style="{StaticResource LogListBoxStyle}">

                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="LogItemStyle"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Style="{StaticResource AlarmLogTextStyle}"/>

                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Button Content="{DynamicResource AutoScroll}"
                                    Command="{Binding ToggleAutoScrollAlarmCommand}"/>

                            <Button Content="{DynamicResource Clear}"
                                    Command="{Binding ClearAlarmCommand}"/>

                        </StackPanel>
                    </Grid>
                </Border>


                <Border Grid.Column="2"
                        Style="{StaticResource LogInnerPanelStyle}">

                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource DebugTitleStyle}">
                                   <Run Text="⚙  "/>
                                   <Run Text="{DynamicResource Log}"/>
                        </TextBlock>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding DebugLogs}"
                                 Style="{StaticResource LogListBoxStyle}">

                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="LogItemStyle"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Style="{StaticResource DebugLogTextStyle}"/>

                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Button Content="{DynamicResource AutoScroll}"
                                    Command="{Binding ToggleAutoScrollCommand}"/>

                            <Button Content="{DynamicResource Clear}"
                                    Command="{Binding ClearDebugCommand}"/>

                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource SystemControlPanelStyle}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource DebugTitleStyle}">
                                   <Run Text="⚙  "/>
                                   <Run Text="{DynamicResource SystemControl}"/>
                        </TextBlock>
                        <Grid Grid.Row="1"
                              Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="0.75*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource MachineState}"
                                                Style="{StaticResource SystemStatusTextStyle}"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource SystemStatusDotStyle}"/>
                                        <TextBlock Text="{DynamicResource Ready}"
                                                   Style="{StaticResource SystemStatusValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource PlcAlive}"
                                               Style="{StaticResource SystemStatusTextStyle}"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource SystemStatusDotStyle}"/>
                                        <TextBlock Text="{DynamicResource Online}"
                                                   Style="{StaticResource SystemStatusValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource VisionAlive}"
                                               Style="{StaticResource SystemStatusTextStyle}"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource SystemStatusDotStyle}"/>
                                        <TextBlock Text="{DynamicResource Online}"
                                                   Style="{StaticResource SystemStatusValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Communication}"
                                               Style="{StaticResource SystemStatusTextStyle}"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource SystemStatusDotStyle}"/>
                                        <TextBlock Text="{DynamicResource Ready}"
                                                   Style="{StaticResource SystemStatusValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0"
                                        Margin="0,0,0,3"
                                        Content="{DynamicResource Emergency}"
                                        Style="{StaticResource EmergencyButtonStyle}"
                                        Command="{Binding EmergencyStopCommand}"/>
                                <Button Grid.Row="1"
                                        Margin="0,3,0,0"
                                        Content="{DynamicResource Reset}"
                                        Style="{StaticResource ResetMachineButtonStyle}"
                                        Command="{Binding ResetMachineCommand}"/>
                            </Grid>
                        </Grid>
                    </Grid>

                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>