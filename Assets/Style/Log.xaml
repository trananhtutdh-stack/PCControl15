<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LogPanelStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#1F2937"/>
        <Setter Property="BorderBrush" Value="#4B5563"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style x:Key="LogInnerPanelStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#111827"/>
        <Setter Property="BorderBrush" Value="#374151"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style x:Key="LogListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="#0B1220"/>
        <Setter Property="BorderBrush" Value="#374151"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Foreground" Value="#D5E2EA"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="LogItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="AlarmTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FF3B3B"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DebugTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#00D9FF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AlarmLogTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#FF6B6B"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DebugLogTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily"
                Value="Consolas"/>
        <Setter Property="FontSize"
                Value="10"/>
        <Setter Property="Foreground"
                Value="#D5E2EA"/>
        <Setter Property="TextWrapping"
                Value="NoWrap"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
    </Style>

    <Style x:Key="SystemControlPanelStyle"
           TargetType="{x:Type Border}">
        <Setter Property="Background"
                Value="#111827"/>
        <Setter Property="BorderBrush"
                Value="#374151"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="CornerRadius"
                Value="3"/>
    </Style>

    <Style x:Key="SystemStatusTextStyle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="#D5E2EA"/>
        <Setter Property="FontSize"
                Value="11"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
    </Style>

    <Style x:Key="SystemStatusValueStyle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground"
                Value="LimeGreen"/>
        <Setter Property="FontSize"
                Value="10"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
    </Style>

    <Style x:Key="SystemStatusDotStyle"
           TargetType="{x:Type Ellipse}">
        <Setter Property="Width"
                Value="8"/>
        <Setter Property="Height"
                Value="8"/>
        <Setter Property="Fill"
                Value="LimeGreen"/>
        <Setter Property="Margin"
                Value="0,0,5,0"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
    </Style>

    <Style x:Key="EmergencyButtonStyle"
           TargetType="{x:Type Button}">
        <Setter Property="Background"
                Value="#B71C1C"/>
        <Setter Property="Foreground"
                Value="White"/>
        <Setter Property="BorderBrush"
                Value="#FF5252"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontWeight"
                Value="Bold"/>
        <Setter Property="Cursor"
                Value="Hand"/>
    </Style>

    <Style x:Key="ResetMachineButtonStyle"
           TargetType="{x:Type Button}">
        <Setter Property="Background"
                Value="Yellow"/>
        <Setter Property="Foreground"
                Value="Black"/>
        <Setter Property="BorderBrush"
                Value="#6B7280"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="FontSize"
                Value="13"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="Cursor"
                Value="Hand"/>
    </Style>

</ResourceDictionary>