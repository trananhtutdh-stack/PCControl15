    <Style x:Key="MotionStatusDot"
       TargetType="{x:Type Ellipse}">

        <Setter Property="Width"
            Value="8"/>

        <Setter Property="Height"
            Value="8"/>

        <Setter Property="Margin"
            Value="0,0,6,0"/>

        <Setter Property="Fill"
            Value="#404040"/>

        <Style.Triggers>

            <MultiDataTrigger>

                <MultiDataTrigger.Conditions>

                    <Condition
                    Binding="{Binding State}"
                    Value="Ready"/>

                    <Condition
                    Binding="{Binding Tag,
                                      RelativeSource={RelativeSource Self}}"
                    Value="Ready"/>

                </MultiDataTrigger.Conditions>

                <Setter Property="Fill"
                    Value="LimeGreen"/>

            </MultiDataTrigger>


            <MultiDataTrigger>

                <MultiDataTrigger.Conditions>

                    <Condition
                    Binding="{Binding State}"
                    Value="Busy"/>

                    <Condition
                    Binding="{Binding Tag,
                                      RelativeSource={RelativeSource Self}}"
                    Value="Busy"/>

                </MultiDataTrigger.Conditions>

                <Setter Property="Fill"
                    Value="Gold"/>

            </MultiDataTrigger>


            <MultiDataTrigger>

                <MultiDataTrigger.Conditions>

                    <Condition
                    Binding="{Binding State}"
                    Value="Error"/>

                    <Condition
                    Binding="{Binding Tag,
                                      RelativeSource={RelativeSource Self}}"
                    Value="Error"/>

                </MultiDataTrigger.Conditions>

                <Setter Property="Fill"
                    Value="Red"/>

            </MultiDataTrigger>

        </Style.Triggers>

    </Style>

    <Style x:Key="CanMoveText"
       TargetType="TextBlock">

        <Setter Property="Text"
            Value="CANT MOVE"/>

        <Setter Property="Foreground"
            Value="#E53935"/>

        <Style.Triggers>

            <DataTrigger Binding="{Binding CanMove}"
                     Value="True">

                <Setter Property="Text"
                    Value="CAN MOVE"/>

                <Setter Property="Foreground"
                    Value="#39D353"/>

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <Style x:Key="CanMoveIndicator"
       TargetType="Ellipse">

        <Setter Property="Width"
            Value="8"/>

        <Setter Property="Height"
            Value="8"/>

        <Setter Property="Fill"
            Value="#707070"/>

        <Setter Property="Margin"
            Value="0,0,6,0"/>

        <Style.Triggers>

            <DataTrigger Binding="{Binding CanMove}"
                     Value="True">

                <Setter Property="Fill"
                    Value="#39D353"/>

            </DataTrigger>

            <DataTrigger Binding="{Binding CanMove}"
                     Value="False">

                <Setter Property="Fill"
                    Value="#E53935"/>

            </DataTrigger>

        </Style.Triggers>

    </Style>

