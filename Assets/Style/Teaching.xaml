<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TeachingPanel"
       TargetType="Border">

        <Setter Property="Background"
            Value="{DynamicResource PanelBrush}"/>

        <Setter Property="BorderBrush"
            Value="{DynamicResource BorderBrush}"/>

        <Setter Property="BorderThickness"
            Value="1"/>

        <Setter Property="CornerRadius"
            Value="5"/>

        <Setter Property="Padding"
            Value="6"/>

        <Setter Property="Margin"
            Value="3"/>

    </Style>


    <Style x:Key="TeachingTitle"
       TargetType="TextBlock">

        <Setter Property="Foreground"
            Value="{DynamicResource AccentBrush}"/>

        <Setter Property="FontSize"
            Value="11"/>

        <Setter Property="FontWeight"
            Value="Bold"/>

        <Setter Property="VerticalAlignment"
            Value="Center"/>

    </Style>

    <Style x:Key="TeachingManualButton"
       TargetType="Button">

        <Setter Property="Height"
            Value="32"/>

        <Setter Property="Margin"
            Value="2"/>

        <Setter Property="Foreground"
            Value="White"/>

        <Setter Property="FontSize"
            Value="10"/>

        <Setter Property="FontWeight"
            Value="SemiBold"/>

        <Setter Property="Background"
            Value="#263746"/>

        <Setter Property="BorderBrush"
            Value="{DynamicResource BorderBrush}"/>

        <Setter Property="BorderThickness"
            Value="1"/>

        <Setter Property="Cursor"
            Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border
                    x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">

                        <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter
                            TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                             Value="True">

                            <Setter
                            TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.75"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <Style x:Key="TeachingSensorDot"
       TargetType="Ellipse">

        <Setter Property="Width"
            Value="8"/>

        <Setter Property="Height"
            Value="8"/>

        <Setter Property="Fill"
            Value="#384A59"/>

        <Setter Property="Stroke"
            Value="#708090"/>

        <Setter Property="StrokeThickness"
            Value="1"/>

        <Setter Property="VerticalAlignment"
            Value="Center"/>

        <Setter Property="HorizontalAlignment"
            Value="Center"/>

    </Style>


    <DataTemplate x:Key="TeachingAxisTemplate">

        <Border
        Width="280"
        Margin="3"
        Padding="8"
        Style="{StaticResource MotionAxisCard}">

            <Grid>

                <Grid.RowDefinitions>

                    <!-- Axis name -->
                    <RowDefinition Height="28"/>

                    <!-- Servo -->
                    <RowDefinition Height="32"/>

                    <!-- Home -->
                    <RowDefinition Height="32"/>

                    <!-- Status -->
                    <RowDefinition Height="40"/>

                    <!-- Jog -->
                    <RowDefinition Height="38"/>

                    <!-- Stop -->
                    <RowDefinition Height="32"/>

                    <!-- Position -->
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- AXIS NAME                                          -->
                <!-- ================================================= -->

                <Grid Grid.Row="0">

                    <TextBlock
                    Text="{Binding Name}"
                    Style="{StaticResource MotionAxisTitle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>

                </Grid>


                <!-- ================================================= -->
                <!-- SERVO                                             -->
                <!-- ================================================= -->

                <Button
                Grid.Row="1"

                Content="{Binding IsServoON,
                                  Converter={StaticResource
                                      BoolToServoTextConverter}}"

                Background="{Binding IsServoON,
                                     Converter={StaticResource
                                         AxisServoBrushConverter}}"

                Style="{StaticResource MotionServoButton}"

                Command="{Binding
                    DataContext.ServoCommand,
                    RelativeSource={RelativeSource
                        AncestorType={x:Type ItemsControl}}}"

                CommandParameter="{Binding}"/>


                <!-- ================================================= -->
                <!-- HOME                                              -->
                <!-- ================================================= -->

                <Button
                Grid.Row="2"

                Content="{Binding IsHomeDone,
                                  Converter={StaticResource
                                      BoolToServoHomeTextConverter}}"

                Background="{Binding IsHomeDone,
                                     Converter={StaticResource
                                         BoolToHomeBrushConverter}}"

                Style="{StaticResource MotionHomeButton}"

                Command="{Binding
                    DataContext.HomeCommand,
                    RelativeSource={RelativeSource
                        AncestorType={x:Type ItemsControl}}}"

                CommandParameter="{Binding}"/>


                <!-- ================================================= -->
                <!-- STATUS                                             -->
                <!-- ================================================= -->

                <Grid Grid.Row="3">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="20"/>
                        <RowDefinition Height="20"/>

                    </Grid.RowDefinitions>


                    <!-- READY / BUSY / ERR / CAN MOVE -->

                    <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal">

                        <Ellipse
                        Tag="Ready"
                        Style="{StaticResource MotionStatusDot}"/>

                        <TextBlock
                        Text="READY"
                        Style="{StaticResource MotionLabel}"/>


                        <Ellipse
                        Tag="Busy"
                        Style="{StaticResource MotionStatusDot}"
                        Margin="8,0,0,0"/>

                        <TextBlock
                        Text="BUSY"
                        Style="{StaticResource MotionLabel}"/>


                        <Ellipse
                        Tag="Error"
                        Style="{StaticResource MotionStatusDot}"
                        Margin="8,0,0,0"/>

                        <TextBlock
                        Text="ERR"
                        Style="{StaticResource MotionLabel}"/>


                        <Ellipse
                        Margin="8,0,0,0"
                        Style="{StaticResource CanMoveIndicator}"/>

                        <TextBlock
                        Style="{StaticResource CanMoveText}"/>

                    </StackPanel>


                    <!-- LIMIT -->

                    <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal">

                        <Ellipse
                        Style="{StaticResource MotionStatusDot}"

                        Fill="{Binding
                            ExternalPositiveLS,
                            Converter={StaticResource
                                BoolToBrushConverter}}"/>

                        <TextBlock
                        Text="L+"
                        Style="{StaticResource MotionLabel}"/>


                        <Ellipse
                        Margin="8,0,0,0"
                        Style="{StaticResource MotionStatusDot}"

                        Fill="{Binding
                            HomeSW,
                            Converter={StaticResource
                                BoolToBrushConverter}}"/>

                        <TextBlock
                        Text="ORG"
                        Style="{StaticResource MotionLabel}"/>


                        <Ellipse
                        Margin="8,0,0,0"
                        Style="{StaticResource MotionStatusDot}"

                        Fill="{Binding
                            ExternalNegativeLS,
                            Converter={StaticResource
                                BoolToBrushConverter}}"/>

                        <TextBlock
                        Text="L-"
                        Style="{StaticResource MotionLabel}"/>

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- JOG                                                -->
                <!-- ================================================= -->

                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="42"/>

                        <ColumnDefinition Width="42"/>

                        <ColumnDefinition Width="42"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Button
                    Grid.Column="0"
                    Content="JOG -"
                    Margin="1"

                    Style="{StaticResource MotionJogButton}"

                    Command="{Binding
                        DataContext.JogNegativeCommand,
                        RelativeSource={RelativeSource
                            AncestorType={x:Type ItemsControl}}}"

                    CommandParameter="{Binding}"/>


                    <RadioButton
                    Grid.Column="1"
                    Content="H"

                    Style="{StaticResource MotionLevelButton}"

                    IsChecked="{Binding JogLevel,
                        Converter={StaticResource
                            JogLevelToBoolConverter},
                        ConverterParameter=3}"

                    Command="{Binding
                        DataContext.JogHighCommand,
                        RelativeSource={RelativeSource
                            AncestorType={x:Type ItemsControl}}}"

                    CommandParameter="{Binding}"/>


                    <RadioButton
                    Grid.Column="2"
                    Content="M"

                    Style="{StaticResource MotionLevelButton}"

                    IsChecked="{Binding JogLevel,
                        Converter={StaticResource
                            JogLevelToBoolConverter},
                        ConverterParameter=2}"

                    Command="{Binding
                        DataContext.JogMediumCommand,
                        RelativeSource={RelativeSource
                            AncestorType={x:Type ItemsControl}}}"

                    CommandParameter="{Binding}"/>


                    <RadioButton
                    Grid.Column="3"
                    Content="L"

                    Style="{StaticResource MotionLevelButton}"

                    IsChecked="{Binding JogLevel,
                        Converter={StaticResource
                            JogLevelToBoolConverter},
                        ConverterParameter=1}"

                    Command="{Binding
                        DataContext.JogLowCommand,
                        RelativeSource={RelativeSource
                            AncestorType={x:Type ItemsControl}}}"

                    CommandParameter="{Binding}"/>


                    <Button
                    Grid.Column="4"
                    Content="JOG +"
                    Margin="1"

                    Style="{StaticResource MotionJogButton}"

                    Command="{Binding
                        DataContext.JogPositiveCommand,
                        RelativeSource={RelativeSource
                            AncestorType={x:Type ItemsControl}}}"

                    CommandParameter="{Binding}"/>

                </Grid>


                <!-- ================================================= -->
                <!-- STOP                                               -->
                <!-- ================================================= -->

                <Button
                Grid.Row="5"
                Content="STOP"
                Margin="0,2"

                Style="{StaticResource MotionStopButton}"

                Command="{Binding
                    DataContext.StopAxisCommand,
                    RelativeSource={RelativeSource
                        AncestorType={x:Type ItemsControl}}}"

                CommandParameter="{Binding}"/>


                <!-- ================================================= -->
                <!-- POSITION                                           -->
                <!-- ================================================= -->

                <Border
                Grid.Row="6"
                Margin="0,4,0,4"
                Padding="6"

                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="20"/>

                            <RowDefinition Height="30"/>

                            <RowDefinition Height="32"/>

                        </Grid.RowDefinitions>


                        <!-- Title -->

                        <TextBlock
                        Grid.Row="0"
                        Text="{DynamicResource MovePosition}"

                        Foreground="{DynamicResource AccentBrush}"
                        FontSize="10"
                        FontWeight="Bold"

                        VerticalAlignment="Center"/>


                        <!-- Current Position -->

                        <Grid Grid.Row="1">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="70"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                            Grid.Column="0"
                            Text="POSITION"
                            Style="{StaticResource MotionLabel}"
                            VerticalAlignment="Center"/>


                            <TextBlock
                            Grid.Column="1"

                            Text="{Binding
                                CurrentPos,
                                StringFormat={}{0:F3}}"

                            Foreground="{DynamicResource AccentBrush}"

                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>

                        </Grid>


                        <!-- Target -->

                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="55"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="32"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                            Grid.Column="0"
                            Text="{DynamicResource Target}"
                            Style="{StaticResource MotionLabel}"
                            VerticalAlignment="Center"/>


                            <TextBox
                            Grid.Column="1"

                            Text="{Binding
                                TargetPos,
                                UpdateSourceTrigger=PropertyChanged}"

                            Style="{StaticResource MotionValue}"

                            HorizontalContentAlignment="Right"
                            VerticalContentAlignment="Center"/>


                            <TextBlock
                            Grid.Column="2"
                            Text="mm"
                            Style="{StaticResource MotionLabel}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"/>

                        </Grid>


                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- MOVE ABS / REL                                    -->
                <!-- ================================================= -->

                <Grid
                Grid.Row="6"
                VerticalAlignment="Bottom"
                Margin="6,0,6,5">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Button
                    Grid.Column="0"
                    Content="{DynamicResource MoveAbsolute}"

                    Style="{StaticResource MotionMoveButton}"

                    Command="{Binding
                        DataContext.MoveAbsoluteCommand,
                        RelativeSource={RelativeSource
                            AncestorType={x:Type ItemsControl}}}"

                    CommandParameter="{Binding}"/>


                    <Button
                    Grid.Column="1"
                    Content="{DynamicResource MoveRelative}"

                    Style="{StaticResource MotionMoveButton}"

                    Command="{Binding
                        DataContext.MoveRelativeCommand,
                        RelativeSource={RelativeSource
                            AncestorType={x:Type ItemsControl}}}"

                    CommandParameter="{Binding}"/>

                </Grid>

            </Grid>

        </Border>

    </DataTemplate>


</ResourceDictionary>