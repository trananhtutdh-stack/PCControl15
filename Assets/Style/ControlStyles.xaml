<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="MotionTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#F5F6FA"/>
        <Setter Property="Foreground" Value="#111827"/>
        <Setter Property="BorderBrush" Value="#4E6F8E"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinWidth" Value="80"/>
    </Style>
    <Style x:Key="MotionComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="#17263A"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="5,2"/>
    </Style>
</ResourceDictionary>