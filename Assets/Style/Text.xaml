<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NavTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="/Assets/Fonts/#Rubik" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="#C7CDDA" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="65,0,0,0" />
    </Style>

    <Style x:Key="NavTextHorizontalStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="/Assets/Fonts/#Rubik" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#C7CDDA" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="MyTextBlock"  TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
